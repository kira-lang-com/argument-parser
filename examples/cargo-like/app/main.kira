import Foundation
import ArgumentParser

// A cargo-shaped application built on the real ArgumentParser library. The
// build command has enough moving parts to be useful as a reference: typed
// options, repeated values, aliases, a default subcommand, filesystem work,
// and an ANSI progress renderer that continuously rewrites five lines.

@Derive(Parsable)
struct BuildArguments {
    let path: String
    let profile: String
    let target: String
    let jobs: Number
    let feature: [String]
    let unit: [String]
    let locked: Bool
    let plain: Bool
    let noProgress: Bool
    let frames: Number
    let delay: Number
}

@Derive(Parsable)
struct CheckArguments {
    let path: String
    let format: String
    let strict: Bool
}

@Derive(Parsable)
struct MetadataArguments {
    let path: String
    let format: String
    let noDeps: Bool
}

namespace ExampleExit {
    let done: Int = 0
    let invalid: Int = 1
    let usage: Int = 2
}

namespace Walk {
    // Build output and tool state, which are not the project's sources.
    let ignored: [String] = [".git", ".kira-build", "target", ".kira", ".idea"]
}

namespace Progress {
    let barWidth: Int = 24
}

enum OutputFormat {
    Text
    Json
}

// The format a `--format` names; its choices are `text` and `json`.
function outputFormat(name: borrow String) -> OutputFormat {
    match name {
        "json" -> return .Json
        else -> return .Text
    }
}

struct ProjectSummary {
    var directories: Number = 0
    var files: Number = 0
    var kiraFiles: Number = 0
    var packageFiles: Number = 0
    var bytes: Number = 0

    function adding(borrow self, other: borrow ProjectSummary) -> ProjectSummary {
        return ProjectSummary {
            directories: self.directories + other.directories,
            files: self.files + other.files,
            kiraFiles: self.kiraFiles + other.kiraFiles,
            packageFiles: self.packageFiles + other.packageFiles,
            bytes: self.bytes + other.bytes,
        }
    }
}

function joinPath(base: borrow String, name: borrow String) -> String {
    if base.isEmpty() { return name }
    if base.endsWith("/") || base.endsWith("\\") { return base + name }
    return "\(base)/\(name)"
}

// What is under `path`: its directories, files, Kira sources, manifests and
// bytes.
function summarized(path: borrow String) -> Result<ProjectSummary, FileFailure> {
    if fileExists(path) {
        let size = match fileSize(path) {
            Ok(bytes) -> bytes
            Error(failure) -> return .Error(failure)
        }
        return .Ok(ProjectSummary {
            files: 1,
            kiraFiles: path.endsWith(".kira") ? 1 : 0,
            packageFiles: path.endsWith("package.kira") ? 1 : 0,
            bytes: size,
        })
    }
    if !isDirectory(path) { return .Ok(ProjectSummary {}) }
    let listing = match listDirectory(path) {
        Ok(found) -> found
        Error(failure) -> return .Error(failure)
    }
    var summary = ProjectSummary { directories: 1 }
    for name in listing.entries {
        if Walk.ignored.contains(name) { continue }
        match summarized(joinPath(path, name)) {
            Ok(inner) -> summary = summary.adding(inner)
            Error(failure) -> return .Error(failure)
        }
    }
    return .Ok(summary)
}

// A manifest declares a package and its kind; a strict one its version too.
function manifestIsValid(text: borrow String, strict: Bool) -> Bool {
    if !text.contains("Package") || !text.contains("let kind") { return false }
    return !strict || text.contains("let version")
}

function featureText(features: borrow [String]) -> String {
    if features.count == 0 { return "default" }
    var text = ""
    for (index, feature) in features.enumerated() { text += index > 0 ? ",\(feature)" : feature }
    return text
}

function unitText(units: borrow [String], frame: Int) -> String {
    if units.count == 0 { return "workspace" }
    return units[frame % units.count]
}

function progressBar(percent: Number) -> String {
    let bounded = percent < 0 ? 0 : (percent > 100 ? 100 : percent)
    let filled = Int(floor(bounded * Progress.barWidth / 100))
    var bar = "["
    for index in 0..Progress.barWidth { bar += index < filled ? "=" : " " }
    return "\(bar)] \(bounded)%"
}

// The five status lines of `frame`.
function buildLines(build: borrow BuildArguments, summary: borrow ProjectSummary, frame: Int) -> [String] {
    if frame == Int(build.frames) - 1 {
        return [
            "    Finished \(build.profile) profile",
            "    Checking \(build.path) (\(summary.files) files)",
            "    Artifacts \(joinPath(build.path, ".kira-build"))",
            "       Target \(build.target) | jobs \(build.jobs)",
            "      Sources \(summary.kiraFiles) .kira files | \(summary.bytes) bytes",
        ]
    }
    let percent = floor((frame + 1) * 100 / build.frames)
    return [
        "   Compiling \(summary.kiraFiles) Kira sources",
        "    Checking \(build.path) (\(summary.files) files)",
        "    Building \(progressBar(percent))",
        "       Profile \(build.profile) | target \(build.target) | jobs \(build.jobs)\(build.locked ? " | locked" : "")",
        "          Unit \(unitText(build.unit, frame)) | features \(featureText(build.feature))",
    ]
}

// Prints `lines`, over the ones printed last when `redraw`.
function draw(lines: borrow [String], redraw: Bool) {
    for (index, line) in lines.enumerated() {
        if !redraw {
            print(line)
        } else if index == 0 {
            print("\e[\(lines.count)A\e[2K\r\(line)")
        } else {
            print("\e[2K\r\(line)")
        }
    }
}

function json(summary: borrow ProjectSummary) -> [JsonMember] {
    return [
        JsonMember { name: "directories", value: .Number(summary.directories) },
        JsonMember { name: "files", value: .Number(summary.files) },
        JsonMember { name: "kiraFiles", value: .Number(summary.kiraFiles) },
        JsonMember { name: "packageFiles", value: .Number(summary.packageFiles) },
        JsonMember { name: "bytes", value: .Number(summary.bytes) },
    ]
}

// The project at `path`, its manifest and what is under it.
struct Project {
    let path: String
    let manifest: FileContents?
    let summary: ProjectSummary
}

function project(path: borrow String) -> Result<Project, String> {
    if !isDirectory(path) { return .Error("project directory does not exist: \(path)") }
    let summary = match summarized(path) {
        Ok(found) -> found
        Error(failure) -> return .Error("cannot read the project: \(traceText(failure))")
    }
    // A project without a manifest is still summarized; each command says
    // whether it needs one.
    var manifest: FileContents? = .None
    match readFile(joinPath(path, "package.kira")) {
        Ok(contents) -> manifest = .Some(contents)
        Error(failure) -> absorb failure
    }
    return .Ok(Project { path: path, manifest: manifest, summary: summary })
}

ParsableCommand RootCommand {
    let configuration: CommandConfiguration {
        return CommandConfiguration {
            name: "kira-build",
            aliases: ["kb"],
            abstract: "A cargo-like build coordinator for Kira workspaces",
            discussion: "Inspect a package.kira project, render a live build plan, and report metadata from the shell.",
            version: .Some("0.1.0"),
            subcommands: ["build", "check", "metadata"],
            defaultSubcommand: .Some("build"),
        }
    }

    let arguments: [ArgumentSpec] {
        return []
    }

    function run(arguments: borrow ParsedArguments) -> Int {
        print("kira-build: choose build, check, or metadata")
        return ExampleExit.done
    }
}

ParsableCommand BuildCommand {
    let configuration: CommandConfiguration {
        return CommandConfiguration { name: "build", aliases: ["b"], abstract: "Plan a workspace build with live cargo-style progress" }
    }

    let arguments: [ArgumentSpec] {
        return [
            argument(name: "path", help: "Project directory").defaulting("."),
            option(name: "profile", help: "Build profile").short("p").oneOf(["dev", "release"]).defaulting("dev"),
            option(name: "target", help: "Compilation target label").short("t").aliased(["target-triple"]).defaulting("host"),
            option(name: "jobs", help: "Concurrent job count").short("j").whole().defaulting("4"),
            option(name: "feature", help: "Enable a feature; may be repeated").short("F").aliased(["features"]).repeating(),
            option(name: "unit", help: "Build one workspace unit; may be repeated").short("u").aliased(["package"]).repeating(),
            flag(name: "locked", help: "Use the locked dependency plan").short("l"),
            flag(name: "plain", help: "Print every frame without ANSI rewriting").short("P"),
            flag(name: "noProgress", help: "Suppress the live progress display").short("q").aliased(["no-progress"]),
            option(name: "frames", help: "Number of progress frames").short("n").aliased(["frame-count"]).whole().defaulting("6"),
            option(name: "delay", help: "Milliseconds between frames").short("d").aliased(["delay-ms"]).whole().defaulting("120"),
        ]
    }

    function run(arguments: borrow ParsedArguments) -> Int {
        let build = parse_BuildArguments(arguments)
        if build.jobs <= 0 || build.frames <= 0 || build.delay < 0 {
            printError("error: jobs and frames must be greater than zero, and the delay not negative")
            return ExampleExit.usage
        }
        let found = match project(build.path) {
            Ok(value) -> value
            Error(reason) -> {
                printError("error: \(reason)")
                return ExampleExit.usage
            }
        }
        if found.manifest.isNone() {
            printError("error: package.kira not found in \(build.path)")
            return ExampleExit.usage
        }
        let last = Int(build.frames) - 1
        if build.noProgress {
            draw(buildLines(build, found.summary, last), false)
            return ExampleExit.done
        }
        for frame in 0..Int(build.frames) {
            draw(buildLines(build, found.summary, frame), frame > 0 && !build.plain)
            if frame < last && build.delay > 0 { processSleep(build.delay) }
        }
        return ExampleExit.done
    }
}

ParsableCommand CheckCommand {
    let configuration: CommandConfiguration {
        return CommandConfiguration { name: "check", aliases: ["c"], abstract: "Validate package.kira and source coverage" }
    }

    let arguments: [ArgumentSpec] {
        return [
            argument(name: "path", help: "Project directory").defaulting("."),
            option(name: "format", help: "Output format").short("f").oneOf(["text", "json"]).defaulting("text"),
            flag(name: "strict", help: "Require a version and Kira sources").short("S"),
        ]
    }

    function run(arguments: borrow ParsedArguments) -> Int {
        let check = parse_CheckArguments(arguments)
        let found = match project(check.path) {
            Ok(value) -> value
            Error(reason) -> {
                printError("error: \(reason)")
                return ExampleExit.usage
            }
        }
        let manifestPath = joinPath(check.path, "package.kira")
        let manifestBytes = match found.manifest {
            Some(manifest) -> manifest.size
            None -> 0
        }
        let valid = match found.manifest {
            Some(manifest) -> manifestIsValid(manifest.text, check.strict) && (!check.strict || found.summary.kiraFiles > 0)
            None -> false
        }
        match outputFormat(check.format) {
            Json -> {
                var members = [
                    JsonMember { name: "path", value: .Text(check.path) },
                    JsonMember { name: "valid", value: .Boolean(valid) },
                    JsonMember { name: "manifestBytes", value: .Number(manifestBytes) },
                ]
                for member in json(found.summary) { members.append(member) }
                print(writeJson(.Object(members)))
            }
            Text -> {
                if !valid {
                    print("invalid: \(manifestPath)")
                    print("expected a versioned Package declaration and .kira sources")
                    return ExampleExit.invalid
                }
                print("valid: \(manifestPath)")
                print("Kira sources: \(found.summary.kiraFiles)")
                print("bytes: \(found.summary.bytes)")
            }
        }
        return ExampleExit.done
    }
}

ParsableCommand MetadataCommand {
    let configuration: CommandConfiguration {
        return CommandConfiguration { name: "metadata", aliases: ["m"], abstract: "Summarize a workspace like cargo metadata" }
    }

    let arguments: [ArgumentSpec] {
        return [
            argument(name: "path", help: "Project directory").defaulting("."),
            option(name: "format", help: "Output format").short("f").oneOf(["text", "json"]).defaulting("text"),
            flag(name: "noDeps", help: "Omit dependency presence from the report").short("D").aliased(["no-deps"]),
        ]
    }

    function run(arguments: borrow ParsedArguments) -> Int {
        let metadata = parse_MetadataArguments(arguments)
        let found = match project(metadata.path) {
            Ok(value) -> value
            Error(reason) -> {
                printError("error: \(reason)")
                return ExampleExit.usage
            }
        }
        let manifest = match found.manifest {
            Some(contents) -> contents
            None -> {
                printError("error: package.kira not found in \(metadata.path)")
                return ExampleExit.usage
            }
        }
        let hasDependencies = !metadata.noDeps && manifest.text.contains("dependencies")
        match outputFormat(metadata.format) {
            Json -> {
                var members = [JsonMember { name: "package", value: .Text(metadata.path) }]
                for member in json(found.summary) { members.append(member) }
                members.append(JsonMember { name: "hasDependencies", value: .Boolean(hasDependencies) })
                print(writeJson(.Object(members)))
            }
            Text -> {
                print("package: \(metadata.path)")
                print("manifest: \(manifest.size) bytes")
                print("directories: \(found.summary.directories)")
                print("files: \(found.summary.files)")
                print("Kira sources: \(found.summary.kiraFiles)")
                print("package manifests: \(found.summary.packageFiles)")
                print("workspace bytes: \(found.summary.bytes)")
                print(hasDependencies ? "dependencies: declared" : "dependencies: omitted or none")
            }
        }
        return ExampleExit.done
    }
}

@Main
function main() -> Int {
    let root = RootCommand()
    let children: [Any ParsableCommand] = [BuildCommand(), CheckCommand(), MetadataCommand()]
    return runCommandRouter(root, children, commandLineArguments())
}
