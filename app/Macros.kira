import Foundation

// `@Derive(Parsable)` is the typed half of the parser.
//
// The runtime parser works with a small, backend-neutral `ParsedArguments`
// value. This derive walks a command's fields at compile time and emits the
// constructor that projects those values into the program's own type: the
// Kira equivalent of Swift ArgumentParser synthesizing a ParsableArguments
// implementation from property wrappers.
//
// A field is a `String`, `Number` or `Int` the schema always fills, being
// required or defaulted; an optional `String?` or `Number?` the command line
// may leave out; a `Bool` flag; or a `[String]` or `[Number]` repeating
// option. The command schema still decides spelling, requiredness, defaults,
// aliases and help text, so the derived function never guesses about the CLI
// surface.

comptime macro Parsable {
    kind { derive }
    appliesTo { struct }
    expand(target: Declaration) -> Syntax {
        var initializers: [Syntax] = []
        var supported = true
        for field in target.fields {
            match field.type {
                "String" -> initializers.append(
                    quote { #{field.name}: raw.requiredText(#{field.name.asString()}) }
                )
                "Number", "Int" -> initializers.append(
                    quote { #{field.name}: raw.requiredNumber(#{field.name.asString()}) }
                )
                "String?", "Optional<String>" -> initializers.append(
                    quote { #{field.name}: raw.text(#{field.name.asString()}) }
                )
                "Number?", "Optional<Number>" -> initializers.append(
                    quote { #{field.name}: raw.number(#{field.name.asString()}) }
                )
                "Bool" -> initializers.append(
                    quote { #{field.name}: raw.flag(#{field.name.asString()}) }
                )
                "[String]" -> initializers.append(
                    quote { #{field.name}: raw.texts(#{field.name.asString()}) }
                )
                "[Number]" -> initializers.append(
                    quote { #{field.name}: raw.numbers(#{field.name.asString()}) }
                )
                else -> {
                    supported = false
                    Diagnostics.error(
                        "Derive(Parsable) supports String, Number, Int, String?, Number?, Bool, [String] and [Number] fields; this field has another type",
                        at: field.syntax
                    )
                }
            }
        }
        if !supported {
            return quote {}
        }
        let fields: Syntax = Syntax.join(initializers, separator: ", ")
        return quote {
            function parse_#{target.name}(raw: borrow ParsedArguments) -> #{target.name} {
                return #{target.name} { #{fields} }
            }
        }
    }
}
