//! The `@Derive(Parsable)` macro, the typed half of the parser.
//!
//! The runtime parser works with a backend-neutral [`ParsedArguments`] value.
//! `@Derive(Parsable)` walks a command's fields at compile time and emits a
//! `parse_<Type>(raw:)` function that projects those values into the program's
//! own struct.
//!
//! A field may be one of these types:
//!
//! - `String` or `Number`: the schema must always fill it, by being required or
//!   defaulted. It is read with `requiredText` or `requiredNumber`.
//! - `String?` or `Number?`: the command line may leave it out.
//! - `Bool`: a flag, read with `flag`.
//! - `[String]` or `[Number]`: every value of a repeating option.
//!
//! The command schema still decides spelling, requiredness, defaults, aliases
//! and help text, so the derived function never guesses about the command-line
//! surface. A field of any other type is a compile-time error.

import Foundation

// The macro. A comment rather than a `///` item doc, because a macro is not a
// documentable declaration.
comptime macro Parsable {
    kind { derive }
    appliesTo { struct }
    expand(target: Declaration) -> Syntax {
        var initializers: [Syntax] = []
        var supported = true
        for field in target.fields {
            match field.type {
                "String" -> initializers.append(
                    quote { #{field.name}: raw.requiredText(#{field.name.asString()}) }
                )
                "Number" -> initializers.append(
                    quote { #{field.name}: raw.requiredNumber(#{field.name.asString()}) }
                )
                "String?", "Optional<String>" -> initializers.append(
                    quote { #{field.name}: raw.text(#{field.name.asString()}) }
                )
                "Number?", "Optional<Number>" -> initializers.append(
                    quote { #{field.name}: raw.number(#{field.name.asString()}) }
                )
                "Bool" -> initializers.append(
                    quote { #{field.name}: raw.flag(#{field.name.asString()}) }
                )
                "[String]" -> initializers.append(
                    quote { #{field.name}: raw.texts(#{field.name.asString()}) }
                )
                "[Number]" -> initializers.append(
                    quote { #{field.name}: raw.numbers(#{field.name.asString()}) }
                )
                else -> {
                    supported = false
                    Diagnostics.error(
                        "Derive(Parsable) supports String, Number, String?, Number?, Bool, [String] and [Number] fields; this field has another type",
                        at: field.syntax
                    )
                }
            }
        }
        if !supported {
            return quote {}
        }
        let fields: Syntax = Syntax.join(initializers, separator: ", ")
        return quote {
            function parse_#{target.name}(raw: borrow ParsedArguments) -> #{target.name} {
                return #{target.name} { #{fields} }
            }
        }
    }
}
