import Foundation

namespace ArgumentLimit {
    // The longest number text taken. A `Number`'s mantissa holds any nineteen
    // digits, and a longer text would overflow it while being read.
    let numberText: Number = 19
}

// The tokens of a command line, taken one at a time. An option takes the
// token after it as its value, so the parser and the option share one cursor.
struct TokenStream {
    let tokens: [String]
    var taken: Number = 0

    function next(borrow mut self) -> String? {
        if self.taken >= self.tokens.count { return .None }
        let token = self.tokens[self.taken]
        self.taken += 1
        return .Some(token)
    }
}

// What one pass over a command line has found so far.
struct ParseState {
    var command: String
    var values: [ParsedValue] = []
    var seen: [String] = []
    var remainder: [String] = []
    // How many positional arguments have been filled.
    var positionals: Number = 0
    // Whether `--`, or the start of the remainder, has been passed: every
    // token after it is an operand, whatever it starts with.
    var operandsOnly: Bool = false

    function add(
        borrow mut self,
        spec: borrow ArgumentSpec,
        text: borrow String
    ) -> Result<Void, ArgumentError> {
        match valueOf(spec, text) {
            Some(value) -> {
                if self.seen.contains(spec.name) && !spec.isRepeated {
                    return .Error(.DuplicateArgument(spec.name))
                }
                self.seen.append(spec.name)
                self.values.append(ParsedValue { name: spec.name, value: value, provided: true })
                return .Ok
            }
            None -> return .Error(.InvalidValue(spec.name))
        }
    }
}

// `--name` or `--name=value`, split at the first `=`.
struct LongOption {
    let name: String
    let inline: String?
}

function longOption(token: borrow String) -> LongOption {
    let body = token.substring(2, token.count)
    match body.indexOf("=") {
        Some(equals) -> return LongOption {
            name: body.substring(0, equals),
            inline: .Some(body.substring(equals + 1, body.count))
        }
        None -> return LongOption { name: body, inline: .None }
    }
}

function isLongToken(token: borrow String) -> Bool {
    return token.count > 2 && token.startsWith("--")
}

function isShortToken(token: borrow String) -> Bool {
    return token.count > 1 && token.startsWith("-") && !token.startsWith("--")
}

// A token that is neither an option nor `--`: a positional argument or a
// command name. A lone `-` is one, as it means standard input to many tools.
function isOperand(token: borrow String) -> Bool {
    return token != "--" && !isLongToken(token) && !isShortToken(token)
}

// The value `text` gives `spec`, or `.None` when it is not one `spec` takes.
function valueOf(spec: borrow ArgumentSpec, text: borrow String) -> ArgumentValue? {
    if spec.choices.count > 0 && !spec.choices.contains(text) { return .None }
    match spec.value {
        Text -> return .Some(.Text(text))
        Boolean -> {
            match text {
                "true" -> return .Some(.Flag(true))
                "false" -> return .Some(.Flag(false))
                else -> return .None
            }
        }
        Number -> {
            match numberIn(text) {
                Some(number) -> return .Some(.Number(number))
                None -> return .None
            }
        }
        Whole -> {
            match numberIn(text) {
                Some(number) -> {
                    if floor(number) != number { return .None }
                    return .Some(.Number(number))
                }
                None -> return .None
            }
        }
    }
}

function numberIn(text: borrow String) -> Number? {
    if text.count > ArgumentLimit.numberText { return .None }
    return parseNumber(text)
}

// Parses a command line against one command's schema.
struct Parser {
    let command: Command

    function argumentNamed(
        borrow self,
        spelling: borrow String,
        kind: ArgumentKind
    ) -> ArgumentSpec? {
        for spec in self.command.arguments {
            if spec.kind == kind && spec.isNamed(spelling) { return .Some(spec) }
        }
        return .None
    }

    function argumentLettered(
        borrow self,
        letter: borrow String,
        kind: ArgumentKind
    ) -> ArgumentSpec? {
        for spec in self.command.arguments {
            if spec.kind == kind && spec.isShort(letter) { return .Some(spec) }
        }
        return .None
    }

    // The positional argument at `position`, counting from zero.
    function positional(borrow self, position: Number) -> ArgumentSpec? {
        var found = 0
        for spec in self.command.arguments {
            if spec.kind != .Positional { continue }
            if found == position { return .Some(spec) }
            found += 1
        }
        return .None
    }

    function parse(borrow self, tokens: borrow [String]) -> Result<ParsedArguments, ArgumentError> {
        var stream = TokenStream { tokens: tokens }
        var state = ParseState { command: self.command.configuration.name }
        while true {
            match stream.next() {
                Some(token) -> {
                    match self.take(token, stream, state) {
                        Ok -> continue
                        Error(error) -> return .Error(error)
                    }
                }
                None -> break
            }
        }
        match self.fillDefaults(state) {
            Ok -> return .Ok(
                ParsedArguments {
                    command: state.command,
                    values: state.values,
                    remainder: state.remainder
                }
            )
            Error(error) -> return .Error(error)
        }
    }

    function take(
        borrow self,
        token: borrow String,
        stream: borrow mut TokenStream,
        state: borrow mut ParseState
    ) -> Result<Void, ArgumentError> {
        if state.operandsOnly { return self.takeOperand(token, state) }
        // A command listing subcommands for help names one first.
        let configuration = self.command.configuration
        if stream.taken == 1 && configuration.subcommands.count > 0 && isOperand(token) {
            if !configuration.subcommands.contains(token) { return .Error(.UnknownCommand(token)) }
            state.command = token
            return .Ok
        }
        match token {
            "--" -> {
                state.operandsOnly = true
                return .Ok
            }
            "--help", "-h" -> return .Error(.HelpRequested)
            "--version", "-V" -> {
                if configuration.version.isSome() { return .Error(.VersionRequested) }
                return self.takeOption(token, stream, state)
            }
            else -> return self.takeOption(token, stream, state)
        }
    }

    function takeOption(
        borrow self,
        token: borrow String,
        stream: borrow mut TokenStream,
        state: borrow mut ParseState
    ) -> Result<Void, ArgumentError> {
        if isLongToken(token) { return self.takeLong(token, stream, state) }
        if isShortToken(token) { return self.takeShort(token, stream, state) }
        return self.takeOperand(token, state)
    }

    function takeLong(
        borrow self,
        token: borrow String,
        stream: borrow mut TokenStream,
        state: borrow mut ParseState
    ) -> Result<Void, ArgumentError> {
        let long = longOption(token)
        match self.argumentNamed(long.name, .Option) {
            Some(spec) -> {
                match long.inline {
                    Some(text) -> return state.add(spec, text)
                    None -> return takeValue(spec, stream, state)
                }
            }
            None -> {
                match self.argumentNamed(long.name, .Flag) {
                    Some(spec) -> {
                        if long.inline.isSome() { return .Error(.UnexpectedValue(long.name)) }
                        return state.add(spec, "true")
                    }
                    None -> return .Error(.UnknownOption("--\(long.name)"))
                }
            }
        }
    }

    // `-abc` is the flags `-a`, `-b` and `-c`, until one of them is an
    // option: the rest of the token, or the next token, is its value.
    function takeShort(
        borrow self,
        token: borrow String,
        stream: borrow mut TokenStream,
        state: borrow mut ParseState
    ) -> Result<Void, ArgumentError> {
        let letters = token.substring(1, token.count)
        for at in 0..letters.count {
            let letter = letters.substring(at, at + 1)
            match self.argumentLettered(letter, .Option) {
                Some(spec) -> {
                    if at + 1 == letters.count { return takeValue(spec, stream, state) }
                    var rest = letters.substring(at + 1, letters.count)
                    if rest.startsWith("=") { rest = rest.substring(1, rest.count) }
                    return state.add(spec, rest)
                }
                None -> {
                    match self.argumentLettered(letter, .Flag) {
                        Some(spec) -> {
                            match state.add(spec, "true") {
                                Ok -> continue
                                Error(error) -> return .Error(error)
                            }
                        }
                        None -> return .Error(.UnknownOption("-\(letter)"))
                    }
                }
            }
        }
        return .Ok
    }

    function takeOperand(
        borrow self,
        token: borrow String,
        state: borrow mut ParseState
    ) -> Result<Void, ArgumentError> {
        match self.positional(state.positionals) {
            Some(spec) -> {
                state.positionals += 1
                return state.add(spec, token)
            }
            None -> {
                if !self.command.configuration.allowsRemainder {
                    return .Error(.UnexpectedArgument(token))
                }
                // The remainder runs to the end, as Swift's
                // `.captureForPassthrough` and POSIX getopt's `+` do:
                // `caffeinate -i date -u` hands `-u` to date, not to
                // caffeinate.
                state.remainder.append(token)
                state.operandsOnly = true
                return .Ok
            }
        }
    }

    // Every argument the command line left out is required, and missing, or
    // takes its default.
    function fillDefaults(
        borrow self,
        state: borrow mut ParseState
    ) -> Result<Void, ArgumentError> {
        for spec in self.command.arguments {
            if state.seen.contains(spec.name) { continue }
            if spec.isRequired { return .Error(.MissingArgument(spec.name)) }
            match spec.defaultText {
                Some(text) -> {
                    match valueOf(spec, text) {
                        Some(value) -> state.values.append(
                            ParsedValue { name: spec.name, value: value, provided: false }
                        )
                        None -> return .Error(.InvalidValue(spec.name))
                    }
                }
                None -> continue
            }
        }
        return .Ok
    }

    function version(borrow self) -> String {
        match self.command.configuration.version {
            Some(version) -> return "\(self.command.configuration.name) \(version)"
            None -> return self.command.configuration.name
        }
    }
}

// An option's value from the token after it.
function takeValue(
    spec: borrow ArgumentSpec,
    stream: borrow mut TokenStream,
    state: borrow mut ParseState
) -> Result<Void, ArgumentError> {
    match stream.next() {
        Some(text) -> return state.add(spec, text)
        None -> return .Error(.MissingValue(spec.name))
    }
}
